# 服务器运行端口
PORT=3000

# 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=cdesign_db

# JWT 密钥（生产环境请使用随机生成的强密钥）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# 前端地址
CLIENT_ORIGIN=http://localhost:5173

# 环境标识 (development / production)
NODE_ENV=development

# DashScope AI 配置（阿里云百炼平台）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_APP_ID=your_dashscope_app_id
